# An identity with accounts of its own: one mailbox and one calendar.
#
# The accounts are credentials like any other, declared with the hosts they may be spent on:
#
#   config/credentials/mail-christian.toml
#     name = "mail/christian"
#     service = "mail"
#     secret_file = "/run/secrets/mail-christian"       # {"user": …, "password": …, "imap": …, "smtp": …}
#
#   config/credentials/caldav-christian.toml
#     name = "caldav/christian"
#     service = "caldav"
#     hosts = ["dav.example.org"]
#     secret_file = "/run/secrets/caldav-christian"     # user:app-password
spec secretary
  description "Reads and files Christian's mail and keeps his calendar."
  max_ttl 24h

  account mail/christian
    allow read, flag, move
    allow send where recipient all ends_with "@merten.dev"

  account caldav/christian
    allow read
    allow write, delete where path starts_with "calendars/christian/personal/"
